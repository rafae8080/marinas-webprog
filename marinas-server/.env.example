MONGO_URI=
JWT_SECRET=
# Comma-separated. One `*` per entry matches Vercel's per-deployment URLs (letters and digits only), e.g.
# CLIENT_ORIGIN=https://marinas-client.vercel.app,https://marinas-client-*-rafae8080s-projects.vercel.app
CLIENT_ORIGIN=https://marinas-client.vercel.app
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_TO=

# RMO chatbot AI (optional, free tier). Any OpenAI-compatible API works; leave AI_API_KEY empty to use the FAQ list only.
# Groq:   AI_API_URL=https://api.groq.com/openai/v1
# Gemini: AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL: pick a current model name from your provider's model list.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=true
AI_DAILY_LIMIT=300
# Optional, for reasoning models (e.g. Groq openai/gpt-oss-*): makes them answer faster.
AI_REASONING_EFFORT=
